# Copy to .env and replace every change_me_* value. `make setup` does both
# and generates the secrets for you.
#
# What is here: the credentials, and which model this deployment calls.
# Nothing else. Nothing here has a safe default - the placeholders below are
# not usable credentials - and nothing here is in git.
#
# Everything else has a file of its own, all of them in git:
#
#   configs/env/deployment.env   the ports, the addresses, the topology and
#                                the role names these passwords go with
#   configs/env/backend.env      how the pipeline behaves
#   configs/env/provider.env     whatever credentials the model needs, which
#                                is the provider's business and not ours
#
# A name appears in EXACTLY ONE of these files. Where a value is derivable -
# the host's view of a published port, a connection string built out of a
# user and a password - it is derived and written nowhere;
# tests/static/test_env_files.py refuses a second copy.
#
# compose is handed this file and deployment.env, this one last, so a name
# here wins. The Makefile does it for you:
#
#     podman compose --env-file configs/env/deployment.env --env-file .env
#
# A tuning decision is not here, because it is worth reviewing in a diff,
# and a command line beats every file:
#
#     make topics-discover TOPIC_PASSES=20

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser
APP_DB_PASSWORD=change_me_app
SEAWEEDFS_DB_PASSWORD=change_me_seaweed
PHOENIX_DB_PASSWORD=change_me_phoenix
DAGSTER_DB_PASSWORD=change_me_dagster
ARGILLA_DB_PASSWORD=change_me_argilla
# Grafana reads the application database as this role: SELECT and nothing
# else, because a dashboard is a place people paste SQL into and the
# application role can DROP. Created by configs/postgres/init.sh.
GRAFANA_DB_PASSWORD=change_me_grafana_reader

# ── The object store ──────────────────────────────────────────────────────
# Empty means the SDK's own default, which is how AWS finds an instance role
# instead of a key. The names must be SET either way: absent raises, so a
# missing env file cannot fall through to somebody's real account.
S3_ACCESS_KEY=change_me_s3_key
S3_SECRET_KEY=change_me_s3_secret

# ── Phoenix ───────────────────────────────────────────────────────────────
# Phoenix creates admin@localhost on first start. Without this it uses the
# password "admin". Only applied when the user is created, so changing it
# later requires dropping the phoenix database.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=change_me_phoenix_ui_password
# Authenticates the services' trace export. Phoenix compares a bearer token
# against this value directly, so there is no key to create in the UI and
# none to rotate. At least 32 characters, containing a digit and a
# lower-case letter; `make doctor` checks all three.
PHOENIX_ADMIN_SECRET=change_me_admin_secret_min_32_chars_with_a_digit_1
PHOENIX_SECRET=change_me_phoenix_secret_32_bytes_min
# The same secret as the exporter sends it. Here rather than in
# deployment.env because expanded it CARRIES the token, and a file in git
# must not. Expanded when the Makefile sources this file; the containers get
# the same header from compose.
OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer ${PHOENIX_ADMIN_SECRET}"

# ── Elasticsearch ─────────────────────────────────────────────────────────
# One node, two jobs: Argilla's index and the pipeline's logs. The node's own
# settings - the certificate paths, the security flags and the heap - are in
# configs/env/elasticsearch.env. Raise ES_JAVA_OPTS there if a long run makes
# it slow; the logs share the heap.
ELASTICSEARCH_PASSWORD=change_me_elasticsearch

# ── Argilla ───────────────────────────────────────────────────────────────
ARGILLA_PASSWORD=change_me_argilla_ui
# Argilla creates this for the owner on first start and shows it under
# "My settings" in the UI. It is not ARGILLA_PASSWORD.
ARGILLA_API_KEY=change_me_argilla_api_key

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ── Which model this deployment calls ─────────────────────────────────────
# Here rather than in configs/env/backend.env because it is one deployment's
# choice and sits next to the credential that reaches it, not a project
# default: HOW the model is called - the mode, the temperature, the timeout,
# the attempt count - is in backend.env and is the same wherever this runs.
#
# Credentials are not here either. Which env vars a provider needs is the
# provider's own business - one key, or three for Entra ID, or four for
# Bedrock - so the three services that call a model read them from
# configs/env/provider.env, which is gitignored and optional. litellm reads
# whichever its own needs:
#
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY   a hosted provider
#   OLLAMA_API_KEY                                      Ollama behind a gateway
#   HOSTED_VLLM_API_KEY     with LLM_MODEL=hosted_vllm/<model>
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION_NAME    Bedrock
#   AZURE_API_KEY, AZURE_API_VERSION    Azure, with LLM_MODEL=azure/<deployment>
#
# Azure with Entra ID instead of a key needs no key variable at all, in the
# order litellm tries them: a service principal, which is the only one a
# container can use, as AZURE_TENANT_ID, AZURE_CLIENT_ID and
# AZURE_CLIENT_SECRET; then DefaultAzureCredential, which is managed or
# workload identity on Azure infrastructure, or `az login` for a host-side
# run only - a container sees nothing of that. AZURE_OPENAI_AD_TOKEN is a
# token you minted yourself, host-side, and expires in about an hour.
#
# Absent is the normal state: Ollama on the host needs none of it.
#
# LiteLLM model identifier. Required: the code carries no default, because a
# guessed model would let a run quietly use one nobody chose. The prefix
# picks the provider, so moving to vLLM is this line and the base URL below,
# and nothing in the code.
#
# Pick a tag whose quantisation matches the runner that will serve it: a
# gemma4:31b-mlx built with nvfp4 weights fails to load under Ollama's MLX
# runner, while the plain gemma4:31b (Q4_K_M) works.
LLM_MODEL=ollama_chat/gemma4:31b
# Where the model is served, as seen from the host. Also required.
LLM_BASE_URL=http://localhost:11434
#
# The model that CHECKS a generated question, by answering it from the cited
# passages alone. A LiteLLM identifier like LLM_MODEL, served at the same
# base URL.
#
# Deliberately different from LLM_MODEL. The gate asks whether the answer can
# be recovered from the evidence, and a model marking its own work recovers
# what it just wrote: the gate passes everything and measures nothing.
#
# Leave it unset and the writer verifies itself, which the worker warns about
# on every start. That is a usable state for trying the pipeline out and not
# one to build a benchmark with.
# QUESTIONS_VERIFIER_MODEL=ollama_chat/qwen3:14b

# What the CONTAINERS call, which is not always what the host does. Some
# credentials exist only where a person is - an interactive cloud login, a
# key in a login keychain - and a provider that needs one is a provider the
# containers cannot use while the host can. Both drain the same queues at
# once, so the corpus is done by whichever is free.
#
# REQUIRED, and it does NOT fall back to LLM_MODEL above: compose refuses to
# start without it, and `make doctor` fails on it. Inheriting the host's
# model is how a stale container spent 2,019 restarts failing to
# authenticate to Azure. It has to name an Ollama model, because a container
# holds no cloud credential and must never reach a hosted provider - doctor
# checks that too.
#
# The address is OLLAMA_CONTAINER_URL below, and there is no overriding it.
# The same model as LLM_MODEL here, so a clone pulls one; name a smaller one
# to leave the host the larger.
LLM_CONTAINER_MODEL=ollama_chat/gemma4:31b
# The verifier as the containers reach it. Optional, and its absence means
# something: the writer then marks its own work.
# QUESTIONS_VERIFIER_CONTAINER_MODEL=ollama_chat/granite4.2:8b

# Where Ollama is, as the host sees it and as a container does. The second
# is required by compose: localhost inside a container is the container.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTAINER_URL=http://host.docker.internal:11434

# One stage calling a different model from the rest is EXTRACTION_MODEL,
# TOPIC_MODEL and QUESTIONS_MODEL, each in configs/env/backend.env beside
# its own stage's settings. Absent means the stage calls LLM_MODEL above.

# ── The evaluation phase ──────────────────────────────────────────────────
# An LLM judge over every fact, topic and question the pipeline produced, run
# AFTER all of it and never during. See backend/assessment/README.md. WHICH
# artefacts are judged and how many is in configs/env/backend.env; whether it
# may run and who judges are here, because both are one deployment's
# decision.
#
# It is a separate phase because it is a separate question. Every stage above
# decides what to keep; this one decides nothing at all. It records an
# opinion beside the checker's verdict, so the two can be compared and the
# places they disagree can be put in front of a person.
#
# Off by default, and that default is a cost decision rather than a doubt:
# judging a corpus is a model call per artefact and three per question, so a
# deployment should ask for it.
#
# Off, `make assess` says so and stops, the Dagster asset reports that it is
# off rather than that it did nothing, and the Assessment page draws an empty
# queue. Nothing else in the pipeline changes either way.
ASSESSMENT_ENABLED=false
#
# WHO JUDGES. Deliberately different from LLM_MODEL, and the argument is the
# verifier's only stronger: the entire value of this phase is that it is an
# opinion the pipeline does not already hold, and a model asked whether its
# own facts follow from its own evidence answers yes. Leave it unset and the
# worker warns about exactly that on every start.
#
# A judge is not a gate and cannot become one, so a smaller model here is a
# reasonable trade in a way it would not be in a gate: what a wrong
# judgement costs is one row in a review queue.
ASSESSMENT_JUDGE_MODEL=ollama_chat/qwen3:14b
# The judge as the CONTAINERS reach it. Unset, they judge with
# LLM_CONTAINER_MODEL above; the line above does not pass through, for the
# reason LLM_MODEL does not.
# ASSESSMENT_JUDGE_CONTAINER_MODEL=
