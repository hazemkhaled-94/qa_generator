# Copy to .env and replace every change_me_* value.
#
# What is here: credentials, ports, and the addresses a host reaches a service
# at. Nothing here has a safe default — the placeholders below are not usable
# credentials — and nothing here is in git.
#
# What is not here: how the pipeline behaves. Every setting the backend reads
# is in configs/env/backend.env, which is in git because a tuning decision is
# worth reviewing in a diff. compose hands that file to the backend services
# and the Makefile sources it for the host commands, so one value reaches
# both, and a command line beats both:
#
#   make topics-discover TOPIC_PASSES=20

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser
POSTGRES_PORT=5432

APP_DB_NAME=qa_generator
APP_DB_USER=qa_generator
APP_DB_PASSWORD=change_me_app

SEAWEEDFS_DB_NAME=seaweedfs
SEAWEEDFS_DB_USER=seaweedfs
SEAWEEDFS_DB_PASSWORD=change_me_seaweed
SEAWEEDFS_DB_SSLMODE=disable

PHOENIX_DB_NAME=phoenix
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=change_me_phoenix

DAGSTER_DB_NAME=dagster
DAGSTER_DB_USER=dagster
DAGSTER_DB_PASSWORD=change_me_dagster

ARGILLA_DB_NAME=argilla
ARGILLA_DB_USER=argilla
ARGILLA_DB_PASSWORD=change_me_argilla

DATABASE_URL=postgresql+psycopg://qa_generator:change_me_app@localhost:5432/qa_generator

# ── SeaweedFS ─────────────────────────────────────────────────────────────
SEAWEEDFS_REPLICATION=001
SEAWEEDFS_MASTER_PEERS=seaweedfs-master:9333
SEAWEEDFS_VOLUME_SIZE_MB=1024
SEAWEEDFS_MAX_VOLUMES=100
SEAWEEDFS_DATACENTER=dc1
SEAWEEDFS_RACK=rack1

SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_VOLUME2_PORT=8081
SEAWEEDFS_FILER_PORT=8888

S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=change_me_s3_key
S3_SECRET_KEY=change_me_s3_secret
S3_BUCKETS=documents,parsed,export

# ── Phoenix ───────────────────────────────────────────────────────────────
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_ENABLE_AUTH=true
# Phoenix creates admin@localhost on first start. Without this it uses the
# password "admin". Only applied when the user is created, so changing it
# later requires dropping the phoenix database.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=change_me_phoenix_ui_password
# Authenticates the services' trace export. Phoenix compares a bearer token
# against this value directly, so there is no key to create in the UI and
# none to rotate — it lives here with the other secrets. At least 32
# characters, containing a digit and a lower-case letter.
PHOENIX_ADMIN_SECRET=change_me_admin_secret_min_32_chars_with_a_digit_1
PHOENIX_SECRET=change_me_phoenix_secret_32_bytes_min
# gRPC from inside the network, which is what the SDK exporter speaks.
OTEL_CONTAINER_ENDPOINT=http://phoenix:4317
# For a process run on the host, e.g. `make schema` or `make parse`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Expanded when the Makefile sources this file; the containers get the
# same header from compose.
OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer ${PHOENIX_ADMIN_SECRET}"
# Phoenix's HTTP API, which is where the golden-set datasets and their
# experiments go. The two lines above are the gRPC collector that receives
# spans; this is the same service read the other way, and it authenticates
# with PHOENIX_ADMIN_SECRET like they do. The host's address: the runner
# is a make target, not a container.
PHOENIX_BASE_URL=http://localhost:6006

# ── Streamlit ─────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
# Every service, the frontend included, which is why it is here and not in
# configs/env/backend.env: the frontend does not read that file.
LOG_LEVEL=INFO
# Rows per page in the frontend listings.
PAGE_SIZE=50

# ── Backend API ───────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Reached from inside the streamlit container, so this is the compose service
# name, not localhost. Use http://localhost:8000 only when running the
# frontend natively on the host.
BACKEND_URL=http://api:8000

# ── Extraction model ──────────────────────────────────────────────────────
# Which model, and where it is served. Here rather than in
# configs/env/backend.env because it is one deployment's choice: the rest of
# the extraction settings are the same wherever this runs, and these are not.
#
# LiteLLM model identifier. Required: the code carries no default, because a
# guessed model would let a run quietly use one nobody chose. The prefix picks
# the provider, so moving to vLLM is this line and the base URL below, and
# nothing in the code.
#
# Pick a tag whose quantisation matches the runner that will serve it: a
# gemma4:31b-mlx built with nvfp4 weights fails to load under Ollama's MLX
# runner, while the plain gemma4:31b (Q4_K_M) works.
LLM_MODEL=ollama_chat/gemma4:31b
# Where the model is served, as seen from the host. Also required.
LLM_BASE_URL=http://localhost:11434
# The same model as the containers see it. localhost inside a container is
# the container, so it cannot be the line above. Leave unset for Ollama on
# the host; set it empty for a hosted provider with its own address.
# LLM_CONTAINER_URL=
# Credentials are not here. Which env vars a provider needs is the provider's
# own business - one key, or three for Entra ID, or four for Bedrock - so the
# three services that call a model read them from configs/env/provider.env,
# which is gitignored and optional. litellm reads whichever its own needs:
#
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY   a hosted provider
#   OLLAMA_API_KEY                                      Ollama behind a gateway
#   HOSTED_VLLM_API_KEY     with LLM_MODEL=hosted_vllm/<model>
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION_NAME    Bedrock
#   AZURE_API_KEY, AZURE_API_VERSION    Azure, with LLM_MODEL=azure/<deployment>
#
# Azure with Entra ID instead of a key needs no key variable at all, in the
# order litellm tries them: a service principal, which is the only one a
# container can use, as AZURE_TENANT_ID, AZURE_CLIENT_ID and
# AZURE_CLIENT_SECRET; then DefaultAzureCredential, which is managed or
# workload identity on Azure infrastructure, or `az login` for a host-side
# run only - a container sees nothing of that. AZURE_OPENAI_AD_TOKEN is a
# token you minted yourself, host-side, and expires in about an hour.
#
# Absent is the normal state: Ollama on the host needs none of it.
#
# The model that CHECKS a generated question, by answering it from the cited
# passages alone. A LiteLLM identifier like LLM_MODEL, served at the same
# base URL, and here rather than in backend.env for the same reason that one
# is: which second model a deployment can afford to run is the deployment's.
#
# Deliberately different from LLM_MODEL. The gate asks whether the answer can
# be recovered from the evidence, and a model marking its own work recovers
# what it just wrote: the gate passes everything and measures nothing.
#
# Leave it unset and the writer verifies itself, which the worker warns about
# on every start. That is a usable state for trying the pipeline out and not
# one to build a benchmark with.
# QUESTIONS_VERIFIER_MODEL=ollama_chat/qwen3:14b
#
# One stage calling a different model from the rest is EXTRACTION_MODEL,
# TOPIC_MODEL and QUESTIONS_MODEL, each beside its own stage's settings in
# configs/env/backend.env. Each is optional, and absent means the stage calls
# whatever LLM_MODEL above names.

# ── Dagster ───────────────────────────────────────────────────────────────
DAGSTER_WEBSERVER_PORT=3000

# ── Elasticsearch ─────────────────────────────────────────────────────────
# The node's own settings — the certificate paths, the security flags and the
# heap — are in configs/env/elasticsearch.env.
#
# One node, two jobs: Argilla's index and the pipeline's logs. Raise
# ES_JAVA_OPTS there if a long run makes it slow; the logs share the heap.
ELASTICSEARCH_PASSWORD=change_me_elasticsearch

# ── Grafana ───────────────────────────────────────────────────────────────
# Reads the log indices Filebeat writes, and the application database.
# 3001 because Dagster already has 3000 and Grafana's own port inside the
# container is 3000 too.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
# How Grafana reads the application database for the "Pipeline state"
# dashboard, which counts queue depths and acceptance rates off the tables
# that hold them. A role of its own with SELECT and nothing else: a
# dashboard is a place people paste SQL into, and the application role can
# DROP.
#
# Created by configs/postgres/init.sh, which runs only on the first boot of
# an empty postgres_data volume. On a stack that already has one, re-run it
# by hand - it is idempotent:
#
#   podman compose exec postgres bash /docker-entrypoint-initdb.d/init.sh
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change_me_grafana_reader

# ── Argilla ───────────────────────────────────────────────────────────────
# Where a person reviews what the models decided: a fact's verdict, a
# topic's name, a question's fate. The database stays the source of truth -
# `make review-pull-questions` brings the answers home, and the copy in
# Argilla is disposable. How a sample is drawn is in configs/env/review.env.
ARGILLA_PORT=6900
ARGILLA_USERNAME=admin
ARGILLA_PASSWORD=change_me_argilla_ui
# As the review tool reaches it. The host's address, not the compose
# service name: the tool runs on the host, like `make schema`.
ARGILLA_API_URL=http://localhost:6900
# Argilla creates this for the owner on first start and shows it under
# "My settings" in the UI. It is not ARGILLA_PASSWORD.
ARGILLA_API_KEY=change_me_argilla_api_key
# One workspace per deployment, so two people reviewing two corpora do not
# annotate each other's rows. Created on first push if it is not there.
ARGILLA_WORKSPACE=qa_generator

# ── Dev only ──────────────────────────────────────────────────────────────
ADMINER_PORT=9001

# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTAINER_URL=http://host.docker.internal:11434
