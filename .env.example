# Copy to .env and replace every change_me_* value.
#
# What is here: credentials, ports, and the addresses a host reaches a service
# at. Nothing here has a safe default — the placeholders below are not usable
# credentials — and nothing here is in git.
#
# What is not here: how the pipeline behaves. Every setting the backend reads
# is in configs/env/backend.env, which is in git because a tuning decision is
# worth reviewing in a diff. compose hands that file to the backend services
# and the Makefile sources it for the host commands, so one value reaches
# both, and a command line beats both:
#
#   make topics-discover TOPIC_PASSES=20

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser
POSTGRES_PORT=5432

APP_DB_NAME=qa_generator
APP_DB_USER=qa_generator
APP_DB_PASSWORD=change_me_app

SEAWEEDFS_DB_NAME=seaweedfs
SEAWEEDFS_DB_USER=seaweedfs
SEAWEEDFS_DB_PASSWORD=change_me_seaweed
SEAWEEDFS_DB_SSLMODE=disable

PHOENIX_DB_NAME=phoenix
PHOENIX_DB_USER=phoenix
PHOENIX_DB_PASSWORD=change_me_phoenix

DAGSTER_DB_NAME=dagster
DAGSTER_DB_USER=dagster
DAGSTER_DB_PASSWORD=change_me_dagster

ARGILLA_DB_NAME=argilla
ARGILLA_DB_USER=argilla
ARGILLA_DB_PASSWORD=change_me_argilla

DATABASE_URL=postgresql+psycopg://qa_generator:change_me_app@localhost:5432/qa_generator

# ── SeaweedFS ─────────────────────────────────────────────────────────────
SEAWEEDFS_REPLICATION=001
SEAWEEDFS_MASTER_PEERS=seaweedfs-master:9333
SEAWEEDFS_VOLUME_SIZE_MB=1024
SEAWEEDFS_MAX_VOLUMES=100
SEAWEEDFS_DATACENTER=dc1
SEAWEEDFS_RACK=rack1

SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_VOLUME2_PORT=8081
SEAWEEDFS_FILER_PORT=8888

S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=change_me_s3_key
S3_SECRET_KEY=change_me_s3_secret
S3_BUCKETS=documents,parsed,models,export,archive

# Any S3 implementation, named by these three. The defaults are SeaweedFS's.
# Empty means the SDK's own default - which is how AWS resolves its endpoint
# from the region and finds an instance role instead of a key. Set the names
# either way: absent raises, so a missing env file cannot fall through to
# somebody's real account.
#
#   SeaweedFS, MinIO  ENDPOINT=http://...   REGION=local         STYLE=path
#   AWS S3            ENDPOINT=             REGION=eu-central-1  STYLE=auto
#   Cloudflare R2     ENDPOINT=https://...  REGION=auto          STYLE=path
#   Backblaze B2      ENDPOINT=https://...  REGION=us-west-004   STYLE=path
#
# Buckets are created by configs/seaweedfs/bucket-init.sh here and by the
# provider's own tooling anywhere else. GET /status reports what is missing.
S3_REGION=local
S3_ADDRESSING_STYLE=path
# The gateway as a CONTAINER reaches it. S3_ENDPOINT above is the host's
# and resolves to nothing from inside the network, so compose sets this
# over that name - the same pair as the OTLP collector and Phoenix's API
# below. Left commented because the compose default is this deployment's
# own gateway; set it when the store is somewhere else, or set it empty
# for AWS, which resolves its own endpoint from the region.
# S3_CONTAINER_ENDPOINT=http://seaweedfs-s3:8333

# ── Phoenix ───────────────────────────────────────────────────────────────
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_ENABLE_AUTH=true
# Phoenix creates admin@localhost on first start. Without this it uses the
# password "admin". Only applied when the user is created, so changing it
# later requires dropping the phoenix database.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=change_me_phoenix_ui_password
# Authenticates the services' trace export. Phoenix compares a bearer token
# against this value directly, so there is no key to create in the UI and
# none to rotate — it lives here with the other secrets. At least 32
# characters, containing a digit and a lower-case letter.
PHOENIX_ADMIN_SECRET=change_me_admin_secret_min_32_chars_with_a_digit_1
PHOENIX_SECRET=change_me_phoenix_secret_32_bytes_min
# gRPC from inside the network, which is what the SDK exporter speaks.
OTEL_CONTAINER_ENDPOINT=http://phoenix:4317
# For a process run on the host, e.g. `make schema` or `make parse`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Expanded when the Makefile sources this file; the containers get the
# same header from compose.
OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer ${PHOENIX_ADMIN_SECRET}"
# Phoenix's HTTP API, which is where the golden-set datasets, their
# experiments and the gate verdicts go. The two lines above are the gRPC
# collector that receives spans; this is the same service read the other
# way, and it authenticates with PHOENIX_ADMIN_SECRET like they do. The
# host's address, because a make target is what reads this file.
PHOENIX_BASE_URL=http://localhost:6006
# The same API as a CONTAINER reaches it. Read by compose, which sets it
# over PHOENIX_BASE_URL inside each service - the pair above does exactly
# that for the collector. Nothing reads this name itself, deliberately: a
# host command sources this file, and an address it cannot resolve would
# otherwise be the one it used.
PHOENIX_CONTAINER_BASE_URL=http://phoenix:6006

# ── Streamlit ─────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
# Every service, the frontend included, which is why it is here and not in
# configs/env/backend.env: the frontend does not read that file.
LOG_LEVEL=INFO
# Where a process writes the JSON lines the shipper reads. The HOST's
# directory, bind-mounted into filebeat; compose sets the container's own
# path over this name, as it does for the collector and Phoenix's API. So a
# `make` target's lines reach Grafana beside a worker's, joined to the same
# trace, and `host.name` is what tells the two apart.
#
# Set it to nothing and a process logs to the terminal and nowhere else,
# which is what every host command used to do.
LOG_DIR=logs
# Rows per page in the frontend listings.
PAGE_SIZE=50

# ── Backend API ───────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Reached from inside the streamlit container, so this is the compose service
# name, not localhost. Use http://localhost:8000 only when running the
# frontend natively on the host.
BACKEND_URL=http://api:8000

# Where the api finds the orchestrator, for `POST /pipeline/run` - the one
# control that takes a corpus through every stage in order. Running them in
# order means waiting for each to drain before starting the next, and a
# request cannot hold that wait, so it is asked for as a Dagster run.
#
# Optional, and the only address in this file whose absence is a supported
# deployment rather than a missing value. Unset, `GET /pipeline` answers
# `available: false`, the Run button says why it is disabled, and every
# other route is unaffected - including the corpus-wide Start, Stop and
# Retry, which are queue verbs and need nobody's permission.
#
# compose supplies the container's view of it (`http://dagster-webserver:3000`).
# This line is for an api run on the host, where it is the published port.
# DAGSTER_URL=http://localhost:3000

# ── Extraction model ──────────────────────────────────────────────────────
# Which model, and where it is served. Here rather than in
# configs/env/backend.env because it is one deployment's choice: the rest of
# the extraction settings are the same wherever this runs, and these are not.
#
# LiteLLM model identifier. Required: the code carries no default, because a
# guessed model would let a run quietly use one nobody chose. The prefix picks
# the provider, so moving to vLLM is this line and the base URL below, and
# nothing in the code.
#
# Pick a tag whose quantisation matches the runner that will serve it: a
# gemma4:31b-mlx built with nvfp4 weights fails to load under Ollama's MLX
# runner, while the plain gemma4:31b (Q4_K_M) works.
LLM_MODEL=ollama_chat/gemma4:31b
# Where the model is served, as seen from the host. Also required.
LLM_BASE_URL=http://localhost:11434
#
# And the MODEL as the containers see it, which is not always the host's.
# Some credentials exist only where a person is - an interactive cloud
# login, a key in a login keychain - and a provider that needs one is a
# provider the containers cannot use while the host can. Naming a local
# model here runs both at once: the containers on this one, the host on
# LLM_MODEL, each taking whatever it claims first.
#
# REQUIRED, and it does NOT fall back to LLM_MODEL above: compose refuses
# to start without it, and `make doctor` fails on it. Inheriting the host's
# model is how a stale container spent 2,019 restarts failing to
# authenticate to Azure. It has to name an Ollama model, because a
# container holds no cloud credential and must never reach a hosted
# provider - doctor checks that too.
#
# The address is OLLAMA_CONTAINER_URL at the foot of this file, and there
# is no overriding it. The same model as LLM_MODEL here, so a clone pulls
# one; name a smaller one to leave the host the larger.
LLM_CONTAINER_MODEL=ollama_chat/gemma4:31b
# The verifier as the containers reach it. Optional, and its absence means
# something: the writer then marks its own work.
# QUESTIONS_VERIFIER_CONTAINER_MODEL=ollama_chat/granite4.2:8b
# Credentials are not here. Which env vars a provider needs is the provider's
# own business - one key, or three for Entra ID, or four for Bedrock - so the
# three services that call a model read them from configs/env/provider.env,
# which is gitignored and optional. litellm reads whichever its own needs:
#
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY   a hosted provider
#   OLLAMA_API_KEY                                      Ollama behind a gateway
#   HOSTED_VLLM_API_KEY     with LLM_MODEL=hosted_vllm/<model>
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION_NAME    Bedrock
#   AZURE_API_KEY, AZURE_API_VERSION    Azure, with LLM_MODEL=azure/<deployment>
#
# Azure with Entra ID instead of a key needs no key variable at all, in the
# order litellm tries them: a service principal, which is the only one a
# container can use, as AZURE_TENANT_ID, AZURE_CLIENT_ID and
# AZURE_CLIENT_SECRET; then DefaultAzureCredential, which is managed or
# workload identity on Azure infrastructure, or `az login` for a host-side
# run only - a container sees nothing of that. AZURE_OPENAI_AD_TOKEN is a
# token you minted yourself, host-side, and expires in about an hour.
#
# Absent is the normal state: Ollama on the host needs none of it.
#
# The model that CHECKS a generated question, by answering it from the cited
# passages alone. A LiteLLM identifier like LLM_MODEL, served at the same
# base URL, and here rather than in backend.env for the same reason that one
# is: which second model a deployment can afford to run is the deployment's.
#
# Deliberately different from LLM_MODEL. The gate asks whether the answer can
# be recovered from the evidence, and a model marking its own work recovers
# what it just wrote: the gate passes everything and measures nothing.
#
# Leave it unset and the writer verifies itself, which the worker warns about
# on every start. That is a usable state for trying the pipeline out and not
# one to build a benchmark with.
# QUESTIONS_VERIFIER_MODEL=ollama_chat/qwen3:14b
#
# One stage calling a different model from the rest is EXTRACTION_MODEL,
# TOPIC_MODEL and QUESTIONS_MODEL, each in configs/env/backend.env beside its
# own stage's settings. Absent means the stage calls LLM_MODEL above.

# ── The evaluation phase ──────────────────────────────────────────────────
# An LLM judge over every fact, topic and question the pipeline produced,
# run AFTER all of it and never during. See backend/assessment/README.md.
#
# It is a separate phase because it is a separate question. Every stage
# above decides what to keep; this one decides nothing at all. It records an
# opinion beside the checker's verdict, so the two can be compared and the
# places they disagree can be put in front of a person.
#
# Whether it runs. Off by default, and that default is a cost decision
# rather than a doubt: judging a corpus is a model call per artefact and
# three per question, so a deployment should ask for it.
#
# Off, `make assess` says so and stops, the Dagster asset reports that it is
# off rather than that it did nothing, and the Assessment page draws an
# empty queue. Nothing else in the pipeline changes either way.
ASSESSMENT_ENABLED=false
#
# WHO JUDGES. A LiteLLM identifier like LLM_MODEL, served at the same base
# URL, and here rather than in backend.env for the reason
# QUESTIONS_VERIFIER_MODEL is: which second model a deployment can afford to
# run is the deployment's.
#
# Deliberately different from LLM_MODEL, and the argument is the verifier's
# only stronger. The entire value of this phase is that it is an opinion the
# pipeline does not already hold; a model asked whether its own facts follow
# from its own evidence answers yes. Leave it unset and the worker warns
# about exactly that on every start.
#
# A judge is not a gate and cannot become one, so a smaller model here is a
# reasonable trade in a way it would not be in a gate: what a wrong
# judgement costs is one row in a review queue.
ASSESSMENT_JUDGE_MODEL=ollama_chat/qwen3:14b
# The judge as the CONTAINERS reach it, and the line above does not pass
# through to them: the reason LLM_CONTAINER_MODEL exists applies here too,
# and `make assess` on the host may reach a hosted provider from a shell
# that has the credential.
#
# Unset, the worker judges with LLM_CONTAINER_MODEL - its own Ollama -
# and says on every start that it is marking its own work. Name something
# else here to point it elsewhere, a hosted provider included:
# provider.env is already given to the processes that call a model, so it
# will authenticate. A decision to make, not a default to inherit.
# ASSESSMENT_JUDGE_CONTAINER_MODEL=ollama_chat/qwen3:14b

# ── Dagster ───────────────────────────────────────────────────────────────
DAGSTER_WEBSERVER_PORT=3000

# ── Elasticsearch ─────────────────────────────────────────────────────────
# The node's own settings — the certificate paths, the security flags and the
# heap — are in configs/env/elasticsearch.env.
#
# One node, two jobs: Argilla's index and the pipeline's logs. Raise
# ES_JAVA_OPTS there if a long run makes it slow; the logs share the heap.
ELASTICSEARCH_PASSWORD=change_me_elasticsearch

# ── Grafana ───────────────────────────────────────────────────────────────
# Reads the log indices Filebeat writes, and the application database.
# 3001 because Dagster already has 3000 and Grafana's own port inside the
# container is 3000 too.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
# How Grafana reads the application database for the "Pipeline state"
# dashboard, which counts queue depths and acceptance rates off the tables
# that hold them. A role of its own with SELECT and nothing else: a
# dashboard is a place people paste SQL into, and the application role can
# DROP.
#
# Created by configs/postgres/init.sh, which runs only on the first boot of
# an empty postgres_data volume. On a stack that already has one, re-run it
# by hand - it is idempotent:
#
#   podman compose exec postgres bash /docker-entrypoint-initdb.d/init.sh
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change_me_grafana_reader

# ── Argilla ───────────────────────────────────────────────────────────────
# Where a person reviews what the models decided: a fact's verdict, a
# topic's name, a question's fate. The database stays the source of truth -
# `make review-pull-questions` brings the answers home, and the copy in
# Argilla is disposable. How a sample is drawn is in configs/env/review.env.
ARGILLA_PORT=6900
ARGILLA_USERNAME=admin
ARGILLA_PASSWORD=change_me_argilla_ui
# As the review tool reaches it. The host's address, not the compose
# service name: the tool runs on the host, like `make schema`.
ARGILLA_API_URL=http://localhost:6900
# Argilla creates this for the owner on first start and shows it under
# "My settings" in the UI. It is not ARGILLA_PASSWORD.
ARGILLA_API_KEY=change_me_argilla_api_key
# One workspace per deployment, so two people reviewing two corpora do not
# annotate each other's rows. Created on first push if it is not there.
ARGILLA_WORKSPACE=qa_generator

# Where the infrastructure containers send their log lines. Published on
# the host because the engine's logging driver is the engine's, not a
# container's: it resolves no compose service name and is not on this
# network.
SYSLOG_PORT=9000

# ── Dev only ──────────────────────────────────────────────────────────────
ADMINER_PORT=9001

# Where a person opens each service, as `name=url` pairs. What the System
# health page links to, and what `make services` prints.
#
# Composed by compose out of the ports above and handed to the api, which is
# the only thing that reads it. Left commented here deliberately: a value on
# this line is read by nothing and would be a second copy of every port,
# free to disagree with the one compose builds. Change a port above and the
# links follow on their own.
#
# Optional throughout. A service left out is still reported, just without a
# link, which is what happens to everything that has no page of its own.
# SERVICE_URLS=

# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTAINER_URL=http://host.docker.internal:11434
