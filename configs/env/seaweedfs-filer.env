# Filer metadata store. Fixed values: the filer keeps its metadata in
# PostgreSQL rather than in the embedded LevelDB, so both flags are part of
# that choice rather than something to tune. The database name, user,
# password and sslmode are credentials and stay in .env.

WEED_LEVELDB2_ENABLED=false
WEED_POSTGRES_ENABLED=true

WEED_POSTGRES_HOSTNAME=postgres
WEED_POSTGRES_PORT=5432

WEED_POSTGRES_CONNECTION_MAX_IDLE=10
WEED_POSTGRES_CONNECTION_MAX_OPEN=50
