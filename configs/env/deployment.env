# Where this deployment puts things: its ports, its addresses, its topology
# and the names it knows its own roles by.
#
# In git, like configs/env/backend.env and for the same reason - none of it
# is a credential, and a port or a role name is worth reviewing in a diff.
# The passwords that go with these names are in .env, which is not.
#
# compose reads this file for `${...}` interpolation, so the Makefile hands
# it to every compose command:
#
#     podman compose --env-file configs/env/deployment.env --env-file .env
#
# .env comes last and therefore wins, which is what lets a secret override a
# name here. Use `make` and it is done for you; a bare `podman compose` needs
# the flags or COMPOSE_ENV_FILES, and `make doctor` says so.
#
# Plain KEY=value throughout, no `${...}`: bash sources this file directly
# and compose parses it as an env file, and only one of those two expands.
#
# THE HOST'S VIEW OF A PUBLISHED PORT IS NOT WRITTEN HERE. It is derived
# from the port, by the Makefile for a host command and by compose for a
# container, so that changing a port moves every address that names it. Each
# one is declared below as a comment where it would otherwise sit.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# One server, five databases. The superuser creates them and the roles;
# configs/postgres/init.sh is what runs.
POSTGRES_SUPERUSER=postgres
POSTGRES_PORT=5432

APP_DB_NAME=qa_generator
APP_DB_USER=qa_generator

SEAWEEDFS_DB_NAME=seaweedfs
SEAWEEDFS_DB_USER=seaweedfs
SEAWEEDFS_DB_SSLMODE=disable

PHOENIX_DB_NAME=phoenix
PHOENIX_DB_USER=phoenix

DAGSTER_DB_NAME=dagster
DAGSTER_DB_USER=dagster

ARGILLA_DB_NAME=argilla
ARGILLA_DB_USER=argilla

# How Grafana reads the application database for the "Pipeline state"
# dashboard, which counts queue depths and acceptance rates off the tables
# that hold them. A role of its own with SELECT and nothing else: a
# dashboard is a place people paste SQL into, and the application role can
# DROP.
#
# Created by configs/postgres/init.sh, which runs only on the first boot of
# an empty postgres_data volume. On a stack that already has one, re-run it
# by hand - it is idempotent:
#
#   podman compose exec postgres bash /docker-entrypoint-initdb.d/init.sh
GRAFANA_DB_USER=grafana_reader

# The application's connection string is NOT here and is in no file: it
# carries APP_DB_PASSWORD, so writing it down would be a second copy of a
# secret, free to disagree with the first. compose builds it for a container
# and the Makefile builds it for a host command, both out of the four names
# above.
# DATABASE_URL=

# ── SeaweedFS ─────────────────────────────────────────────────────────────
SEAWEEDFS_REPLICATION=001
SEAWEEDFS_MASTER_PEERS=seaweedfs-master:9333
SEAWEEDFS_VOLUME_SIZE_MB=1024
SEAWEEDFS_MAX_VOLUMES=100
SEAWEEDFS_DATACENTER=dc1
SEAWEEDFS_RACK=rack1

SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_VOLUME2_PORT=8081
SEAWEEDFS_FILER_PORT=8888

# ── The object store ──────────────────────────────────────────────────────
S3_PORT=8333
S3_BUCKETS=documents,parsed,models,export,archive

# Any S3 implementation, named by these two and by the endpoint. The values
# here are SeaweedFS's. Empty means the SDK's own default - which is how AWS
# resolves its endpoint from the region and finds an instance role instead
# of a key. Set the names either way: absent raises, so a missing env file
# cannot fall through to somebody's real account.
#
#   SeaweedFS, MinIO  ENDPOINT=http://...   REGION=local         STYLE=path
#   AWS S3            ENDPOINT=             REGION=eu-central-1  STYLE=auto
#   Cloudflare R2     ENDPOINT=https://...  REGION=auto          STYLE=path
#   Backblaze B2      ENDPOINT=https://...  REGION=us-west-004   STYLE=path
#
# Buckets are created by configs/seaweedfs/bucket-init.sh here and by the
# provider's own tooling anywhere else. GET /status reports what is missing.
S3_REGION=local
S3_ADDRESSING_STYLE=path

# The gateway as a CONTAINER reaches it. Overridable because the store need
# not be this one: a deployment pointing at AWS or R2 sets this to the same
# address its host uses, or to nothing at all for AWS.
S3_CONTAINER_ENDPOINT=http://seaweedfs-s3:8333

# The gateway as the HOST reaches it, derived from S3_PORT above.
# S3_ENDPOINT=

# ── Phoenix ───────────────────────────────────────────────────────────────
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_ENABLE_AUTH=true

# The trace collector as a CONTAINER reaches it: gRPC from inside the
# network, which is what the SDK exporter speaks.
OTEL_CONTAINER_ENDPOINT=http://phoenix:4317
# Phoenix's HTTP API as a CONTAINER reaches it. The same service read the
# other way: the collector receives spans, this is what a gate verdict is
# posted through.
PHOENIX_CONTAINER_BASE_URL=http://phoenix:6006

# Both of those as the HOST reaches them - `make schema`, `make parse`, the
# golden-set experiments - derived from the two ports above.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# PHOENIX_BASE_URL=

# ── The backend API ───────────────────────────────────────────────────────
BACKEND_PORT=8000

# The api as a CONTAINER reaches it: the compose service name, which is what
# streamlit and the orchestrator hold.
BACKEND_CONTAINER_URL=http://api:8000
# The api as the HOST reaches it, derived from BACKEND_PORT. This is what a
# make target curls and what a frontend run natively on the host reads; the
# two used to be one name holding the container's value, which is why
# `services` and `pipeline-status` each rebuilt the address by hand.
# BACKEND_URL=

# Where the api finds the orchestrator, for `POST /pipeline/run` - the one
# control that takes a corpus through every stage in order.
#
# Optional, and the only address here whose absence is a supported
# deployment rather than a missing value. Unset, `GET /pipeline` answers
# `available: false`, the Run button says why it is disabled, and every
# other route is unaffected - including the corpus-wide Start, Stop and
# Retry, which are queue verbs and need nobody's permission.
#
# compose supplies the container's view. Set this only for an api run on the
# host, where it is the published port.
# DAGSTER_URL=http://localhost:3000

# ── The frontend ──────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
# Rows per page in the listings.
PAGE_SIZE=50

# ── Logging ───────────────────────────────────────────────────────────────
# Every service, the frontend included, which is why it is here and not in
# configs/env/backend.env: the frontend does not read that file.
LOG_LEVEL=INFO
# Where a HOST process writes the JSON lines the shipper reads, bind-mounted
# into filebeat; compose sets the container's own path over this name. So a
# make target's lines reach Grafana beside a worker's, joined to the same
# trace, and `host.name` is what tells the two apart.
#
# Set it to nothing and a process logs to the terminal and nowhere else.
LOG_DIR=logs
# Where the infrastructure containers send their lines. Published on the
# host because the engine's logging driver is the engine's, not a
# container's: it resolves no compose service name and is not on this
# network.
SYSLOG_PORT=9000

# ── Dagster ───────────────────────────────────────────────────────────────
DAGSTER_WEBSERVER_PORT=3000

# ── Grafana ───────────────────────────────────────────────────────────────
# Reads the log indices Filebeat writes, and the application database. 3001
# because Dagster already has 3000 and Grafana's own port inside the
# container is 3000 too.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin

# ── Argilla ───────────────────────────────────────────────────────────────
# Where a person reviews what the models decided: a fact's verdict, a
# topic's name, a question's fate. The database stays the source of truth -
# `make review-pull-questions` brings the answers home, and the copy in
# Argilla is disposable. How a sample is drawn is in configs/env/review.env.
ARGILLA_PORT=6900
ARGILLA_USERNAME=admin
# One workspace per deployment, so two people reviewing two corpora do not
# annotate each other's rows. Created on first push if it is not there.
ARGILLA_WORKSPACE=qa_generator
# As the review tool reaches it, derived from ARGILLA_PORT: the tool runs on
# the host, like `make schema`.
# ARGILLA_API_URL=

# ── Dev only ──────────────────────────────────────────────────────────────
ADMINER_PORT=9001

# Where a person opens each service, as `name=url` pairs. What the System
# health page links to, and what `make services` prints.
#
# Composed by compose out of the ports above and handed to the api, which is
# the only thing that reads it. Left commented deliberately: a value here
# would be read by nothing and would be a second copy of every port, free to
# disagree with the one compose builds.
# SERVICE_URLS=

# The spaCy pipelines baked into the image are NOT named here. They are
# derived from NLP_MODELS in configs/env/backend.env, which is what decides
# which pipelines get LOADED - the two disagreeing is a worker that starts
# and then cannot read a language.
# SPACY_MODELS=
