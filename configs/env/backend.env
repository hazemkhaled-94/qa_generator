# Settings for the api and the four workers.
#
# Every value here is a tuning decision rather than a credential, which is why
# this file is in git and .env is not. compose hands it to each backend
# service with env_file and the Makefile sources it for the host commands, so
# one value reaches both.
#
# Plain KEY=value throughout: bash sources this file directly, so a value with
# a space would be word-split.
#
# LOG_LEVEL is not here: the frontend reads it too, and it would have to be
# written twice to reach both.

# Connections per process. Every worker, the api and each host command open
# their own pool, so the total is this times however many are running; keep it
# under PostgreSQL's max_connections.
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=5

# How long a worker waits before looking at an empty queue again. The queue
# is the signal - a row becomes claimable the moment somebody starts the
# stage - so nothing has to notify anybody, at the cost of one cheap query
# per worker per interval.
WORKER_POLL_SECONDS=5

# ── Ingestion ─────────────────────────────────────────────────────────────
# The version stamped on every stored object is NOT here. It describes the
# build rather than the deployment, so it is read from `version` in
# pyproject.toml - one place, and no env copy of it to drift.
# Keep in step with server.maxUploadSize in frontend/.streamlit/config.toml,
# or Streamlit rejects the file before the API sees it.
MAX_FILE_SIZE_MB=100
ALLOWED_MIME_TYPES=application/pdf

# ── Language pipelines ────────────────────────────────────────────────────
# The spaCy pipeline per language, as `language:model`. Chunking splits a
# passage into the numbered sentences a fact cites and writes its lemmas;
# extraction reads a statement's parse to judge it. Both are recorded on
# every fact, because the parser decides the verdict.
#
# The models must be present in the image - `make install` and the Dockerfile
# download them, and nothing fetches one at run time. Use the trained
# pipelines, not a blank one: the rule-based splitter breaks German legal
# text on "Abs.", "Nr." and "z. B.".
#
# Medium, not small. de_core_news_sm does not tag a German modal as a finite
# verb - "Ein Risikobericht muss erstellt werden" reads as no claim at all -
# so the atomicity check rejected 11% of German facts for a parser
# limitation. Measured over eight regulatory sentences: sm 3/8, md 8/8.
# This is also the list the language detector may answer with: detecting a
# language with no pipeline behind it tells nobody anything.
NLP_MODELS=de:de_core_news_md,en:en_core_web_md
# Used for a passage too short for the detector to judge, and for any language
# NLP_MODELS does not name.
NLP_DEFAULT_LANGUAGE=en

# Languages that write every noun with a capital. In one of these a lower-case
# word tagged as a noun is a word from another language, not a subject: the
# German pipeline reads the English "the", "and" and "of" as proper nouns, and
# they reached the top terms of two of the twelve German topics. Empty is
# valid, and means no language is read that way.
NLP_CAPITALISED_NOUNS=de

# ── Parsing ───────────────────────────────────────────────────────────────
# Characters per page below which a document is treated as scanned. OCR is not
# implemented, so such a document is refused with that reason rather than
# converted into an empty one. This is also the switch OCR will read when it
# is added.
PARSING_OCR_CHAR_THRESHOLD=100

# Lowest confidence a conversion may carry and still be kept, read as the
# converter's own lower bound rather than its mean: the lower bound says how
# bad the worst of the document is. A document under this fails parsing with
# the measurement, rather than becoming facts nothing vouches for. Measured
# over this corpus the lower bounds run 0.72 to 0.94, so 0.5 refuses a
# genuinely broken conversion and nothing that is merely untidy.
PARSING_MIN_CONFIDENCE=0.5
# TableFormer mode: fast or accurate.
PARSING_TABLE_MODE=accurate
# Whether the parser rebuilds the heading tree. Without it every section
# header comes back at level one.
PARSING_HEADING_HIERARCHY=true
# Docling has no timeout of its own; one pathological file would occupy a
# worker indefinitely. This has to sit well above an ordinary document on the
# slowest hardware it will run on, or it fires on ordinary files instead of
# pathological ones: a 56-page document took over 990 seconds on two CPU
# cores.
PARSING_TIMEOUT_SECONDS=1800
# Where Docling's model weights live. Read by Docling itself, so it must be
# either a real path or absent: an empty value resolves to the working
# directory and every conversion fails. Leave commented out to let Docling
# download the weights on first use, which fails in a container with no
# network.
# DOCLING_ARTIFACTS_PATH=/opt/docling-models

# ── Embedding ─────────────────────────────────────────────────────────────
# The one embedding model this deployment uses, and the only tokenizer in the
# project. Chunking counts a passage's tokens with it; question embeddings are
# produced by it. One name so those two can never disagree: a passage sized by
# one tokenizer and embedded by another is silently truncated at embed time,
# and a benchmark built on truncated passages misreports its own coverage.
#
# Its width must match questions.embedding, which is vector(1024). Changing
# the model means a migration for that column and re-embedding everything.
# multilingual-e5-large: 1024 wide, 512-token window, covers de and en.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# The model's context window, and so the longest passage the chunker emits.
# Keep these equal. Larger silently truncates at embed time; smaller wastes
# the window and fragments tables for nothing.
EMBEDDING_MAX_TOKENS=512

# ── Encoders that run in this process ─────────────────────────────────────
# Judgements an encoder makes better than a served model does, or makes as
# well for a thousandth of the cost. Each runs under transformers in the
# worker that needs it, beside the embedding model: no second container, no
# second address, and no chat interface - these are not chat models and no
# runtime that serves chat models can serve them.
#
# Every one is named here rather than written into the code, because which
# encoder reads German best is a measurement a deployment re-makes. Empty
# turns a judgement back over to the served model, which is what a
# deployment with no measurement of its own should leave it as.
#
# What to weigh when replacing one:
#   - multilingual, and evaluated on German rather than merely trained on it;
#   - a three-way NLI head for NLI_MODEL, labelled entailment/neutral/
#     contradiction, which nlp/entailment.py reads off the checkpoint rather
#     than assuming an order;
#   - a SQuAD-2-style head for QA_MODEL, which is what gives it the "no
#     answer here" it needs to say `in_passage` is false.
#
# On the two defaults:
#
# NLI_MODEL is mDeBERTa-v3, which Microsoft pre-trained, with an NLI head
# fine-tuned by an individual rather than by a company. That is worth knowing
# and it is not an oversight: no organisation publishes a multilingual NLI
# model. The companies publish base encoders and rerankers. This one is MIT,
# it reports 0.871 on English XNLI and 0.824 on German, and it is the most
# used NLI checkpoint on the hub by an order of magnitude.
#
# QA_MODEL is deepset's, which is a company's, evaluated on German XQuAD at
# 78.8 F1 and on German MLQA at 66.2. It is the less popular of the two by a
# long way; it is here because extractive QA with a no-answer class is
# exactly the shape of the judgement it replaces.
#
# Both are left EMPTY by default. Nothing in this pipeline uses them until a
# deployment has run `make test-eval` and seen its own numbers, because a
# judgement swapped on somebody else's benchmark is a judgement nobody has
# measured.
NLI_MODEL=
# NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
QA_MODEL=
# QA_MODEL=deepset/xlm-roberta-large-squad2

# How sure the NLI model must be before its entailment counts as support. A
# probability rather than the likeliest label, which is the reason to prefer
# an encoder to a served model answering true or false: a boolean carries no
# confidence and a deployment cannot decide how sure it wants a gate to be.
NLI_ENTAILMENT_THRESHOLD=0.7

# The longest premise and hypothesis pair an encoder reads, in tokens. Both
# defaults above have a 512-token window.
ENCODER_MAX_TOKENS=512

# ── Chunking ──────────────────────────────────────────────────────────────
# The passage size bounds live in EMBEDDING_MAX_TOKENS above, in the one unit
# the chunker works in. There is no character floor and no character ceiling:
# a character count is a different unit from the budget, and being a different
# unit is how the ceiling came to fire before the budget it was meant to back
# up and discard whole tables that were within it.
#
# Nothing is dropped now. An undersized chunk with no peer to merge into is
# stored as it stands, because a passage is a reflection of the document and
# the extractor already skips what carries no claim.
#
# Combine undersized neighbours that share a heading. Off leaves one-line
# passages, which retrieve poorly and carry too little to draw a fact from.
CHUNKING_MERGE_PEERS=true

# ── Extraction ────────────────────────────────────────────────────────────
# Which model, and where it is served, are not here. They are one deployment's
# choice rather than a project default - the host reaches the model at one
# address and a container at another - so LLM_MODEL,
# LLM_BASE_URL and LLM_CONTAINER_URL are in .env
# beside the API keys.
#
# How the model is made to answer in the shape asked for, as an
# instructor.Mode name. A property of the provider, not of this service:
# JSON_SCHEMA suits a self-hosted runtime (Ollama, vLLM), which constrains
# decoding; a hosted provider usually wants ANTHROPIC_TOOLS or TOOLS. A name
# that is not a mode is refused at start-up with the list of ones that are.
LLM_STRUCTURED_MODE=JSON_SCHEMA
# Zero: the same passage must give the same facts on a re-run, or the
# benchmark moves under its own feet.
LLM_TEMPERATURE=0
# How long to wait for one passage. Size it from a measurement rather than a
# guess: on one test corpus a median passage took 473s on a 31B model and the
# longest 517s, so a 180s limit timed out on every one of them. A smaller
# model or faster hardware wants a smaller number.
LLM_TIMEOUT_SECONDS=900
# How many times to try one passage before failing it. With the timeout
# above, this also sets how long a claim may go unfinished before another
# worker sweeps it: the lease is derived from the two, so raising either one
# never makes a healthy worker look abandoned.
#
# One budget, two paths. A connection failure or a timeout is retried in
# the process, with a short exponential backoff; a rate limit is retried by
# litellm, which waits as long as the provider's Retry-After asks - twenty
# to sixty seconds on a hosted provider, where a backoff of our own would
# give up before the limit cleared.
LLM_MAX_ATTEMPTS=3

# The context window to ask the runtime for, in tokens. Leave it unset for a
# hosted provider, which sizes its own and has no such parameter.
#
# A self-hosted runtime reserves the whole window as key-value cache before
# it reads anything. A model advertising 131,072 tokens therefore holds
# several gigabytes for a prompt of two thousand, and on a machine also
# running the pipeline that is the difference between generating and
# swapping: one 12B model at its advertised window took 9.6 GB and every
# call timed out at 900 seconds.
#
# Size it from the longest prompt a stage sends. Extraction sends one
# passage, capped at EMBEDDING_MAX_TOKENS; question generation sends up to
# QUESTIONS_FACT_SAMPLE facts and two passages, plus the prompt itself.
# 8192 covers both with room to spare.
#
# Commented out because there is no value that suits every provider: a
# hosted one has no such parameter and refuses the request carrying it.
# Uncomment it for Ollama or vLLM, or set it in the platform panel, which
# needs no restart.
# LLM_NUM_CTX=8192

# How much a thinking model may think before it answers. `low`, `medium` or
# `high` let it think; anything else - `off` - turns thinking off, which is
# what every call in this pipeline wants. Leave it unset to take the model's
# own default.
#
# Every stage here asks for a structured answer, and a thinking model asked
# for one spends its window reasoning and then has no room to answer:
# measured on a 12B model, 7,469 tokens of reasoning, the length limit, and
# an empty string back after 307 seconds. The same call with thinking off
# took 9 seconds and answered correctly.
#
# The name is OpenAI's, because a hosted provider reads it directly. Ollama
# reads it as `think`.
#
# Commented out because the two providers spell the off switch differently
# and neither accepts the other's: `off` for Ollama, `none` for a hosted
# reasoning model, which also refuses any temperature but 1 without it.
# There is therefore no default that starts on both, and a wrong value is
# refused at the first call rather than quietly ignored.
#
# SET ONE. Absent does not mean thinking off - it means the parameter is
# omitted and the model keeps its own default, which for a thinking model
# is thinking. That is the 307-second empty answer described above.
# LLM_REASONING_EFFORT=off

# There are no similarity thresholds here. A fact cites a numbered sentence
# instead of quoting one, so a citation is either exact or names a sentence
# that does not exist; and what a statement asserts is read off its spaCy
# parse rather than guessed from how many words it shares with its source.
# See NLP_MODELS above.

# Which kinds of fact a run writes. `atomic` is mandatory and is what every
# question is scored against; the other three are readings of the same
# passages:
#
#   atomic    one claim from one sentence, citing it by number
#   summary   two or three sentences standing in for a whole passage
#   outline   the points that passage makes, one bullet each
#   bridge    one claim no single passage states, over a group of them
#
# summary and outline come from ONE extra model call per passage, so naming
# either roughly doubles what a corpus costs to read and naming both costs no
# more than naming one. A passage carrying fewer than two claims is not
# digested at all: it is already as short as its own summary.
#
# bridge is not part of that call and not part of the passage queue. It is a
# pass of its own - `make extract-bridge` - over groups of passages the topic
# model put together, so topics must be fitted before it will find anything.
EXTRACTION_KINDS=atomic,summary,outline,bridge

# The longest a summary or an outline may be, as a share of the passage it
# stands in for. Above it the fact is refused as `not_condensed`: something
# as long as what it replaces saves a reader nothing. Measured in characters
# after collapsing whitespace, so it is the same number in both languages.
# Raised from 0.6 after measuring where it fired. A digest is a fixed size -
# two or three sentences, or two to six points - so the share it comes to is
# decided by the passage, not by the model. Over this corpus the median
# summary was 50% of its passage and the median outline 47%, both well
# inside; what 0.6 cut was the tail, and that tail is short passages. At
# 0.75 a digest is still a quarter shorter than what it replaces, which is
# the thing this check exists to guarantee.
EXTRACTION_DIGEST_MAX_SHARE=0.75

# The shortest passage worth digesting at all, in characters after
# collapsing whitespace. 0 digests every passage carrying enough claims.
#
# The companion to the share above, and the half that saves money. Against a
# passage under 400 characters the median summary was 99% of it and 92% were
# refused as not_condensed; from 1,200 up, none were. Those calls were paid
# for and thrown away. Measured together on this corpus: 800 with a share of
# 0.75 yields 1,065 usable digests against 1,010 today, and asks for 596
# fewer of them.
EXTRACTION_DIGEST_MIN_CHARS=800

# The smallest share of a passage's facts that may be something other than
# atomic. 0 turns it off.
#
# A passage yields a fixed number of digests - one summary, one outline -
# however much it says, so the only thing that moves the balance between the
# kinds is how many atomic facts sit beside them. That makes this floor a cap
# on those: d others beside n atomic is a share of d/(n+d), so the largest n
# holding the others at this share is d(1-share)/share. At two digests, a
# third wants four.
#
# It is why the number matters. Read without a cap this corpus gave 18.4
# atomic facts a passage - an author list became fifty facts of the form "X
# wrote the original edition" - and atomic was 91.9% of everything extracted.
# The cap is asked for in the extraction prompt and enforced again on what
# comes back; the facts over it are refused as `over_cap` and kept, like any
# other refusal. `make extract-recap` applies it to facts already stored
# without calling the model.
EXTRACTION_MIN_OTHER_SHARE=0.33

# How alike two statements may be before the second is refused as a
# `duplicate`. 0 turns the gate off, and with it the embedding of anything
# extraction writes.
#
# Cosine over EMBEDDING_MODEL, against every validated fact in the corpus and
# against the facts this passage has already kept. Both, because neither alone
# is enough: the first misses two copies inside one passage - a summary and an
# atomic fact often say the same thing about a short one - and the second
# misses the same claim restated in the next document.
#
# The whole corpus rather than one topic. A duplicate written from another
# subject is still a duplicate, and narrowing the search to a topic would lose
# it to save nothing: the HNSW index answers a corpus of this size in about
# two milliseconds, which is a rounding error beside the model call that wrote
# the fact.
#
# Set it by what a near twin is worth. This is a reference dataset, so two
# facts saying one thing become two questions asking one thing, and the
# question dedup then throws one away after paying for it. Below about 0.90
# it starts refusing facts that share a subject but assert different things.
EXTRACTION_DUPLICATE_COSINE=0.95

# How many groups of passages one topic is worth, and how many passages one
# group holds. Each group is one model call, so the first number multiplied
# by the topic count is the size of a bridge run.
#
# The passages of a group are taken from as many documents as the topic
# spans, one document in turn, and the groups are spaced evenly from the
# first to the last rather than taken from the topic's start - a topic of
# 46 passages offers 23 groups, and this number of them reaches passage 46
# rather than stopping at 24. Navigation, headings and anything else the
# passage gate refuses are left out before the groups are cut, so a call is
# not spent on a contents page. Two is the useful size: at three and above
# the model tends to write a claim that rests on two of them and name the
# third anyway.
#
# Worth more than it looks. A bridge is the only fact that carries two
# subjects, and `multi_topic` is the third point a question needs to band as
# hard, so how many bridges exist is roughly how many hard questions can be
# written. Five a topic over twelve topics gave 88 of them and 14 were ever
# used; the difficulty mix cannot reach 30% hard on that.
EXTRACTION_BRIDGES_PER_TOPIC=12
EXTRACTION_BRIDGE_PASSAGES=2

# The model that reads a passage. Replaces the model only: the address, the
# mode and the patience stay LLM_*. Unset calls LLM_MODEL.
# EXTRACTION_MODEL=ollama_chat/gemma4:31b

# The model that condenses one into a summary and an outline. Unset uses
# whichever model reads the passage, which is what it did before this
# existed.
#
# Worth naming separately because condensing is the one thing extraction asks
# a model for that a small model is actually trained to do. Reading a passage
# for its claims needs the model to decide what a claim IS and to write each
# one to a rule about finite verbs; a digest is summarisation, which is the
# task every small instruct model is distilled on. It is the first call here
# worth moving somewhere cheaper, and the cheapest to be wrong about: a bad
# digest is refused as `not_condensed` and costs one call.
#
# It still has to answer in the shape - one typed object carrying both the
# summary and the outline - so LLM_STRUCTURED_MODE applies to it and a model
# too small to hold a schema will fail validation rather than answer badly.
# EXTRACTION_DIGEST_MODEL=ollama_chat/qwen3:4b

# ── Topic modelling ───────────────────────────────────────────────────────
# Read by the topic worker only. The vocabulary is not here: chunking writes
# passages.lemmas and the fit reads that column.
#
# One model is fitted per language, over that language's passages only: a
# single model across both spends topics on telling the languages apart
# rather than on telling subjects apart. These settings apply to each.
#
# The model is non-negative matrix factorisation over a tf-idf weighted term
# matrix, not LDA over raw counts. LDA is defined over counts - words drawn
# from a multinomial - so a tf-idf input contradicts its own likelihood, and
# measured here feeding it one was worse than counts. Weighting the input is
# what stops one dominant vocabulary spreading across every topic: measured
# on 501 German passages at twelve topics, term overlap between topics fell
# from 32% to 11% and coherence rose from 0.52 to 0.66.
#
# Every one of these changes what the topics are, so changing one and not
# refitting leaves the stored topics describing settings that no longer
# apply. There is no partial refit to avoid: each topic is estimated relative
# to all the others, so a run is always the whole of a language.

# How many topics to fit, per language. Measured over 501 German and 240
# English passages, three seeds each:
#
#   k    de coherence   biggest topic      en coherence   biggest topic
#   8        0.704            71%              0.561            44%
#   12       0.656            46%              0.553            37%
#   16       0.599            40%              0.591            29%
#   20       0.613            30%              0.582            26%
#
# Coherence alone always prefers fewer topics, because broad topics share
# terms trivially - at four, one German topic held 71% of the corpus, which
# is no partition at all. Read beside that share and beside how far the
# topics overlap, twelve is the best German point: the lowest overlap (11%)
# and the most stable across seeds. English is within its own noise of its
# best there. Re-measure if the corpus grows a lot.
# What to call each language in the naming prompt, as `code:name`. The model
# is told which language to answer in, because the coverage report a name
# appears in is read in that language.
TOPIC_LANGUAGE_NAMES=de:German,en:English

TOPIC_NUM_TOPICS=40

# How many passages one topic is worth. Above 0 this turns TOPIC_NUM_TOPICS
# into a ceiling and fits `passages / this` topics instead, floored at 2.
#
# One fit runs per language and two languages are rarely the same size. This
# corpus carries 1434 passages in one and 51 in the other; twelve topics over
# each gave twelve subjects on one side and twelve slivers of four passages
# on the other, and those slivers produced thirteen questions between them.
# The count has to follow the corpus, because what a topic is worth asking
# about is how much material sits under it, not how many topics were asked
# for.
#
# 40 is the figure this corpus was measured at: it keeps a topic at roughly
# the size twelve gave the larger language before, while letting the number
# of them rise with the material. A topic is also the unit question
# generation claims, so this and QUESTIONS_PER_TOPIC multiply out to how many
# questions a run can write.
#
# 0 turns it off and TOPIC_NUM_TOPICS is fitted whatever the corpus is.
TOPIC_PASSAGES_PER_TOPIC=40

# How many times the model sees the corpus while fitting. More is a better
# fit and a longer wait.
TOPIC_PASSES=10

# Seed for the fit. Fixed on purpose: the same corpus and the same settings
# must give the same topics, or a reference dataset's topic weighting moves
# under its own feet between releases. Change it only to see how stable a
# fit is.
TOPIC_RANDOM_STATE=42

# How many terms are stored as a topic's signature. Also what a label is
# matched on across a refit, so a very short list makes two unrelated topics
# look alike and a label lands on the wrong one.
TOPIC_TOP_TERMS=12

# Smallest passage-to-topic weight worth storing. The model gives a passage a
# weight on many topics, so with no floor passage_topics fills with rows that
# are almost all noise. The weights are normalised, so this reads as a share.
# Must be above 0: the column's CHECK constraint requires it.
TOPIC_MIN_WEIGHT=0.05

# The smallest share of a topic's passages that must carry a validated fact
# before the topic is worth naming. Below it the topic is left unnamed, and
# no model is called for it. 0 names every topic.
#
# The deterministic half of "Mixed". The naming prompt has always offered
# that answer for a topic whose terms share no subject, and over 38 topics it
# was used none: a model reliably names whatever it is shown, so what it is
# shown is decided before the call. One topic here had the terms
# `inhaltsverzeichnis, einfuehrung, urheberschutzvermerk, aenderungsuebersicht,
# danksagung, testverfahren` and was named `Testverfahren` off the one subject
# word among them.
#
# Read off the facts rather than off the terms, which is what keeps it
# language-neutral: a passage extraction found nothing in says nothing,
# whatever language it says it in. A front-matter word list would have to be
# written again for every language NLP_MODELS adds.
#
# Measured over this corpus, by share of a topic's dominant passages carrying
# a validated fact: the two front-matter topics came in at 0.00 and 0.11 and
# the next topic up was 0.56, so anything in that gap separates them and
# nothing else is near it.
#
# Off when the corpus carries no facts at all - on a fit run before
# extraction every topic looks barren, which is the signal being absent
# rather than unanimous.
TOPIC_LABEL_MIN_FACT_SHARE=0.15

# Drop a term appearing in fewer than this many passages. Removes the typos,
# the one-off product names and the OCR debris that would otherwise each get
# a topic to themselves.
TOPIC_NO_BELOW=3

# Drop a term appearing in more than this share of passages. Catches the
# boilerplate no word list could know about - a heading repeated in every
# document, a source note under every table. Not a grammar filter: the
# vocabulary is already only nouns, proper nouns and adjectives, so this can
# sit high enough to keep the cross-cutting terms a corpus actually shares.
#
# Lowering it does not clean up a noisy fit. Swept from 0.02 to 1.0 on this
# corpus: below 0.5 the widespread REAL terms go first, which promotes the
# noise into the top terms rather than removing it, and at 0.02 coherence
# collapses and 120 passages fall out of every topic. Above 0.5 nothing
# changes, because no term reaches half the corpus.
TOPIC_NO_ABOVE=0.5

# The model that names a topic from its terms. Unset calls LLM_MODEL.
# TOPIC_MODEL=ollama_chat/qwen3:14b

# ── Question generation ───────────────────────────────────────────────────
# Read by the question worker only. The unit of work is one topic: the facts
# a question may be written from are the ones whose passage has that topic as
# its strongest, which is also what makes a question's subject measurable.
#
# Which model CHECKS them is in .env, as QUESTIONS_VERIFIER_MODEL, because
# the choice of a second model is one deployment's and because leaving it
# unset is a meaningful state: the writer then marks its own work, which it
# will always pass.
#
# The model that WRITES them is below; unset means LLM_MODEL. Naming the same
# model here and in QUESTIONS_VERIFIER_MODEL is the same as naming neither:
# the two gates only an independent model may apply are off either way.
# QUESTIONS_MODEL=ollama_chat/gemma4:31b
#
# A fit replaces every topic, so fitting again returns every topic to `new`
# and the questions are written again. That costs almost nothing: selection
# skips the facts an accepted question already rests on, so the second run
# writes only about what the first did not reach.

# How many questions to aim for per topic. The real number is lower: a topic
# with fewer passages than this yields fewer questions, and the gates reject
# some of what is written. Each one costs a writer call and a verifier call,
# so this multiplied by the topic count is the size of a full run.
#
# One passage is asked about once, so this is also how much of a topic is
# reached: at 20, a topic of eighty passages is asked about across twenty of
# them, strided over the whole topic rather than taken from its start.
#
# Not below the number of types in QUESTIONS_TYPE_MIX with a weight above
# zero. The mix is spread over these slots, so a topic with fewer slots than
# types never sees some of them.
# Which kinds of fact a question may be written from, of the four
# EXTRACTION_KINDS produces. A name this stage cannot use is refused at
# start-up rather than silently mangled:
#
#   atomic   one claim in one sentence. Every prompt here interpolates
#            facts.statement into a numbered list and every gate reads it as
#            one claim, so this is the shape they were all written for
#   summary  a paragraph standing in for a whole passage. What a definition
#            or a procedure is written from: those ask what a thing IS or HOW
#            it is done, which is a reading of the whole passage and is not
#            in any one sentence of it. It is a checked fact like any other -
#            the same unsupported_addition and unresolved_reference gates
#            judge it - and the verifier is shown the passage it condenses,
#            so a question resting on one is recoverable from the material
#   outline  newline-separated `- ` bullets. An enumeration written from one
#            has a real set behind it, which is what that type needs and
#            what no single atomic claim can give it. Its lines are indented
#            under their own number when a sample is rendered, so they no
#            longer break the numbering the writer cites by
#   bridge   one claim resting on the several passages in fact_passages.
#            The best seed there is for a cross-passage question: it is asked
#            about alone, the verifier is shown every passage it rests on,
#            and its scopes are read off all of them, so one bridge is a
#            cross-document question by itself where its passages are.
#            A bridge drawn before extraction prompt version 2 recorded no
#            sentence citations and is skipped until `make extract-bridge`
#            replaces it
# All four. What was measured against dropping the two digest kinds, so
# the numbers are here rather than lost with the decision:
#
#   kind      validated   a flagged pronoun   framed "Der Abschnitt ..."
#   summary         505               53.3%                       34.9%
#   outline         537               11.9%                        0.0%
#   atomic        4,873                0.9%                        0.5%
#   bridge          327                0.0%                        0.6%
#
# The pronoun column is not the argument it looks like. `_self_contained`
# is not applied to a digest, and that is deliberate: it was written for a
# one-sentence claim, and a pronoun in the second sentence of a summary
# pointing at the first - "die Testbarkeit des SUT ... dass SIE parallel
# zum Entwurf" - resolves perfectly well. Flagged is not dangling.
#
# The real cost is the last column, and it falls on `summary` alone: a
# third of them are framed as descriptions OF the passage rather than
# assertions about its subject, and a question written from one is a
# question about the document. One answer named two conditions whose only
# evidence was "Der Abschnitt behandelt Herausforderungen des
# Fehlermanagements", which contains neither.
#
# Kept anyway, deliberately. They are 17% of the pool and the outlines in
# particular are the best seed there is for `enumeration` and
# `definition`. The fix for the summaries is to stop the digest prompt
# writing "Der Abschnitt behandelt", not to throw the kind away.
QUESTIONS_FACT_KINDS=atomic,summary,outline,bridge

# How many questions one topic is asked for. A ceiling: the topic stops
# early when it runs out of facts nothing has been written from.
#
# This times the topic count is the size of a run. It was 20 over 12 topics,
# which is 240 slots against 1434 passages and 23,098 facts - 18.9% of the
# passages were ever read and 1.8% of the facts. With the topic count now
# following the corpus, 60 over ~35 topics reaches most of it.
#
# 60 over 38 topics came out at 3,131 questions from 1,495 passages: 980 of
# them read and 2,512 of 6,242 facts. Raising it further mostly buys
# duplicates - at 60 they are already the largest rejection reason, 433 of
# 1,054, which is this asking some topics for more than they hold.
QUESTIONS_PER_TOPIC=60

# How many of a topic's facts are offered to the writer per call. It picks
# which of them one question needs and says so, and the difficulty is read
# off what it picked - so this is the size of the OFFER, not of the group a
# question ends up citing.
#
# A cap per sample, divided between the passages the sample holds: a sample
# of two passages offers half of this from each, so both sides of what is
# being asked about are there. It used to flush a group and then add the next
# passage whole, which on a corpus whose median passage carries ten facts
# meant every sample was one passage and no question was ever cross-document.
#
# At 1 every question is written from a single fact. Above about 8 the writer
# starts picking unrelated pairs.
#
# Read together with QUESTIONS_SAMPLES_PER_PASSAGE: a passage holds a fixed
# number of facts, and this is how many of them one sample spends. Four
# atomic facts plus a summary and an outline, at three a sample, is two
# samples from a passage.
QUESTIONS_FACT_SAMPLE=3

# How many times one passage may be offered, each time with facts no earlier
# sample took. A ceiling; what really stops a passage is running out of
# facts nothing has been written from, so a thin passage yields one sample
# and a dense one yields several without either being configured.
#
# It was effectively 1, and that was the ceiling on the whole stage: a
# passage carrying a dozen facts holds a dozen questions and was asked one.
# Nothing is dealt twice - the facts a sample took are spent, not the
# passage - so the dedup gate is not being asked to clean up after this.
QUESTIONS_SAMPLES_PER_PASSAGE=3

# Which kinds of question to write, and in what proportion, as
# `type:weight`. A type with a weight of 0, or absent from this list, is
# never written - this is the switch for choosing what a run produces.
#
# The weights are spread over the slots by highest averages, so they are
# exact over a whole run and interleaved along it rather than run in blocks.
# The scale does not matter, only the ratios.
#
# Every type is a question FORM and none of them is about a subject, so the
# same list applies to a manual, a contract, a policy or a report:
#
#   factoid       one checkable value - how many, how much, by when
#   definition    what a named thing or status IS, as the material defines it
#   entity        who does, decides, owns or must be told something
#   enumeration   which things belong to a named set
#   condition     when, or under what circumstances, something applies
#   reason        why something is required or done
#   procedure     how something is done, or in what order
#   consequence   what happens when something is or is not done
#   comparison    how two named things differ            (needs two passages)
#   aggregation   a total no single fact states          (needs two passages)
#   temporal      what changed between two periods       (needs two passages)
#
# The last three are never planned as `easy`: a comparison drawn from one
# passage is a question about one thing.
#
# A corpus that states few reasons yields few reason questions whatever the
# weight says - the type is refused by its own prompt where the material does
# not support it, and the gates reject what gets written anyway. Read the
# realised mix on the Questions page beside this one.
# Equal weights, because the marginal that is wanted is an even spread of
# kinds across the accepted set. Written evenly is not accepted evenly - the
# types passed at between 8% and 83% - so the balance stops being the
# planner's job at this point and becomes the selection's: `make
# questions-balance` fills an even quota out of whatever the run accepted,
# and overgenerating is what gives it room to.
#
# The last two are the derived kinds, and they are a different thing from
# the other eleven. Every kind above them is answered by a sentence in the
# corpus - recoverability refuses one whose answer is not - so however much
# reading it takes, answering is retrieval. These two put the premises in
# the material and leave the conclusion out of it, so answering means
# reasoning. They cost more per question: an implication needs two passages
# that settle something between them, and where the corpus has none it
# writes nothing.
# `temporal` is 0 for this corpus, which is what a weight of zero is for.
# It asks what changed between two periods, and a syllabus has almost no
# periods: of eight released temporal questions read, two were about
# change over time and the rest were comparisons wearing the name -
# including "Wie unterscheiden sich TM-2.3.1 und ein ML-Framework in
# ihrer Bedeutung?", which compares a learning-objective code to a
# concept. A corpus with releases, versions or reporting periods in it
# should set this back above zero.
QUESTIONS_TYPE_MIX=factoid:1,definition:1,entity:1,enumeration:1,condition:1,reason:1,procedure:1,consequence:1,comparison:1,aggregation:1,temporal:0,implication:1,application:1

# Which difficulty bands to aim for, in what proportion, as `band:weight`.
#
# A request for a SHAPE OF SAMPLE, not a verdict. `difficulty` stays derived
# from what the question turned out to cite - nobody judges it - and this
# decides how wide a sample the writer is offered, which is what makes a band
# reachable at all:
#
#   easy    one passage
#   medium  a neighbouring passage of the same document as well
#   hard    a passage in another document, and a bridging one - a passage
#           whose strongest topic is a different one - where the corpus
#           offers it, which puts all three scopes above one at once
#
# What was asked for is stored as planned_difficulty beside what came out, so
# the share of slots that got the band they wanted is measurable rather than
# assumed. A topic sitting in one document has no cross-document question in
# it: the deal falls back to a narrower sample rather than writing nothing.
# The arithmetic behind these three. The target for the finished set is
# 30/30/30 with the last 10% unanswerable, and an unanswerable question is
# always easy - it is written from one fact, so it scores nothing. Those
# 10 points come out of easy's 30, which leaves 20 easy, 30 medium and 30
# hard to be found among the 90% that are answerable: 22/33/33, near enough
# 2/3/3.
#
# The old 2/2/1 was not the reason the set came out 96.5% easy. Planned
# medium collapsed to easy 83 times and planned hard 30 times, because the
# writer was offered two passages and cited one fact. What fixes that is
# QUESTIONS_RETRIES, which asks again when a question comes out below the
# band its slot wanted, and the bridge facts that make multi_topic
# reachable at all.
QUESTIONS_DIFFICULTY_MIX=easy:2,medium:3,hard:3

# The shortest and longest target answer per answer form, as
# `form:min:max` characters. Every form must be named.
#
# The form is the type's, not the question's: a factoid asks for a value and
# a reason asks for an explanation, so one pair of bounds for all of them
# fits neither. A floor stops a question being scored against something too
# thin to score - `7`, `8%`, `Nein`; a ceiling stops a value question being
# answered with an essay, which is the same failure wearing the other hat.
#
# Measured on one corpus, a floor of 15 on values refused 41% of the accepted
# answers - `70%`, `2025`, `3 Prozent` - which are the most unambiguously
# scoreable answers there are. Keep the value floor at 1 unless you mean it.
QUESTIONS_ANSWER_CHARS=value:1:80,list:3:300,explanation:20:600

# How much of a list or an explanation has to come back for the verifier to
# count as having recovered it, as a share of the content words the target
# answer is about.
#
# A value is compared whole and this does not apply to one: every word of
# `48 hours` is the answer. Prose is not - `raised through the web form and
# confirmed by email` recovers `it is raised through the web form, and
# confirmed by email before work begins` - and demanding every word of a
# paraphrase refuses answers the verifier plainly found. Numbers and names
# are always compared exactly, whatever this says, so `4 hours` never passes
# for `48 hours`.
QUESTIONS_ANSWER_OVERLAP=0.6

# What share of questions are written to have NO answer in the corpus. These
# test whether a chatbot says it does not know instead of inventing
# something, which is half of what this dataset is for. Spread by position
# rather than drawn at random, so 0.25 is exactly one in four and is the same
# one in four on a re-run. 0 writes none and 1 writes nothing else.
#
# An unanswerable question is always planned easy and from one passage: it is
# written by moving one fact out of reach, so a second passage has nothing to
# do with it. Its TYPE is swapped for one that does not span, for the same
# reason: a comparison written from one fact has one side.
#
# Because it is always easy, this share is also a floor under the easy band.
# At 0.10 against a 30/30/30 difficulty mix, the answerable questions have to
# run 22/33/33 for the set to come out even - which is what
# QUESTIONS_DIFFICULTY_MIX is set to.
#
# It was 0.25, and the accepted set came out 45% unanswerable: they passed at
# 87% where answerable questions passed at 30%, because the only gate that
# could refuse one was the verifier finding an answer after all. They were
# not better, they were less tested. QUESTIONS_OFF_TOPIC_OVERLAP and
# QUESTIONS_ELSEWHERE_PASSAGES below are the two gates they now face.
#
# Those gates now bite, so this is an INPUT share and not an output one. At
# 0.10 over 3,131 questions, 239 unanswerable ones were written and 101 were
# accepted - 4.9% of the accepted set, less than half of what was asked for,
# because 93 went as `answerable_after_all`. Raise this above the share the
# release is meant to hold; `make questions-balance` reports what came out.
QUESTIONS_UNANSWERABLE_SHARE=0.10

# How much of what an unanswerable question is ABOUT has to also occur in the
# passages it was drawn from, as a share of its content lemmas. Below it the
# question is refused as `off_topic`. 0 turns the gate off.
#
# What makes an unanswerable question worthless is being easy to decline. A
# question about something the corpus never mentions is declined by any
# chatbot and measures nothing; the one worth asking reads as though this
# material should answer it and does not. The perturbation prompt says so and
# until now nothing checked it.
#
# Compared on the lemmas chunking already stored, so no text is parsed twice.
# A perturbation of a fact keeps most of its subject and moves one thing out
# of reach, which lands well above 0.3; a question about another subject
# entirely shares almost nothing.
QUESTIONS_OFF_TOPIC_OVERLAP=0.3

# How many passages the corpus-wide probe shows the verifier before an
# unanswerable question is accepted. 0 judges one against its own passages
# alone, as every other gate does.
#
# The one claim in this dataset that is about the whole corpus rather than
# about the passages a question cites. Every other gate is right to read the
# citation alone - what is measured is the dataset, not a retriever - but
# "nothing here answers this" is not a property of two passages, and a
# question wrongly carrying it marks a correct chatbot wrong. Costs one
# lemma probe and one model call, on the unanswerable share only.
QUESTIONS_ELSEWHERE_PASSAGES=4

# What share of accepted questions get a follow-up thread, how far a thread
# may run, and which kinds of question the turns take.
#
# A follow-up is the question somebody asks NEXT, and it may lean on the
# conversation - "And for urgent requests?" - which is what makes it worth
# having: a chatbot answering one has to carry the thread.
#
# QUESTIONS_FOLLOWUP_TYPES is cycled down the thread, so a conversation moves
# from a value to the circumstances it applies in to the reason behind it
# rather than asking the same kind of thing three times. Any type name from
# QUESTIONS_TYPE_MIX may appear here, whatever weight it has there.
#
# The cycle STARTS where the thread sits among the followed ones, so a list
# longer than QUESTIONS_MAX_FOLLOWUPS is a rotation rather than a prefix with
# a dead tail. Starting each thread at the first name instead left the third
# kind here unwritten across a whole corpus, and every follow-up in it came
# out `condition` or `reason`.
#
# Not every kind makes a good follow-up, and `comparison` is the worst of the
# three here. A follow-up is written from the SAME sample as its root, so a
# comparison has nothing new to compare with and invents an axis: 14% of the
# accepted comparison follow-ups restate their own question as the answer,
# against 2% for `condition`, which is the best of them. Until a follow-up can
# draw a passage of its own, `condition,reason` is the safer setting.
#
# Only an accepted, answerable question is followed. A thread whose first
# turn has no answer has nothing to follow on from, and one whose root a gate
# refused would be a conversation starting with a question nobody would ask.
# The phrasing gate is not applied to a follow-up, for the same reason: not
# standing alone is the point.
#
# Each follow-up is another writer call and another verifier call, so this
# multiplies what a topic costs. At 0.3 and 2, a topic of twenty questions
# costs about thirty-two.
# Raised from 0.3 after measuring one topic. A follow-up is worth a
# difficulty point on its own - a chatbot answering one has to carry the
# thread - so a follow-up whose answer runs past
# QUESTIONS_LONG_ANSWER_CHARS is a `medium` question that needed no second
# passage, and one drawn from a bridge is a `hard` one. That is the cheap
# half of the band mix: the expensive half is asking the writer to span two
# passages, which it answers by welding two questions together 31% of the
# time.
QUESTIONS_FOLLOWUP_SHARE=0.5
QUESTIONS_MAX_FOLLOWUPS=2

# How many more times one question may be written when the first draft did
# not stand. 0 keeps whatever came back first.
#
# Two things ask for a second draft, and the writer is told which.
#
# A gate refused it, and it is a gate the writer could have satisfied: it
# welded two questions together, it named its own source, it wrote an answer
# of the wrong shape, it wrote something a second reader could not find. Over
# one corpus 43 of 155 rejections were of that kind - questions thrown away
# for how they were written rather than for what they were about.
#
# Or it was accepted and came out narrower than its slot asked for. This is
# the half that makes 30% hard reachable: the writer is offered two passages,
# takes the escape hatch its own rules give it, cites one fact, and the
# question bands easy. That happened to 83 of 96 planned-medium slots and 30
# of 43 planned-hard ones. Here the first draft stands if the second is
# worse, so asking costs a call and never a question.
#
# Every draft is stored, refused ones included. They are drop-rate evidence
# like any other rejection, and hiding them would make the writer look better
# than it is - the number to read is the yield of `make questions-balance`,
# not the share of rows that were accepted.
QUESTIONS_RETRIES=1
QUESTIONS_FOLLOWUP_TYPES=condition,reason,comparison

# Where an answer starts counting as long, for the difficulty band. Not a
# gate: nothing is refused for being above it - QUESTIONS_ANSWER_CHARS is
# what refuses an answer for its length. A chatbot has to produce more of the
# right thing and a grader has more to disagree about, so it is one of the
# five things that make a question harder.
QUESTIONS_LONG_ANSWER_CHARS=60

# How alike two questions have to be before the later one is thrown away, as
# cosine similarity between their embeddings, in [-1, 1]. Multilingual-e5
# puts unrelated questions around 0.7 and paraphrases above 0.95, so the
# usable range here is narrow and high; below about 0.9 it starts rejecting
# genuinely different questions about the same subject. Raise it if the
# duplicate count is high and the questions read as distinct.
QUESTIONS_DUPLICATE_COSINE=0.93

# ── The balanced release ──────────────────────────────────────────────────
# Which of the accepted questions make up the dataset, drawn by
# `make questions-balance`. A column on the rows already there: nothing is
# deleted, the questions left out stay queryable, and a second draw with
# different shares replaces the first.
#
# This exists because accepting a question and composing a set are different
# problems. Over one corpus every gate did its job and the accepted set still
# came out 45% unanswerable and 96.5% easy - what survives a filter is
# whatever the material happened to offer. So the run overgenerates and the
# composition is chosen here.
#
# How many questions the release holds. 0 draws the largest one the accepted
# pool can fill without missing a quota, which is usually what is wanted: the
# size a balanced set can reach is set by whichever bucket is furthest from
# supplying its share, and that is a property of the run rather than a
# number to pick.
QUESTIONS_RELEASE_SIZE=0

# The most of a release that may be questions with no answer. A ceiling, not
# a target: too few tests a little less than it could, too many tests mostly
# whether a chatbot can say no. They are all easy - an unanswerable question
# is written from one fact and scores no difficulty point - so this share
# sits inside the easy band below rather than beside it.
QUESTIONS_RELEASE_UNANSWERABLE=0.10

# How the release spreads over the difficulty bands, as `band:weight`, over
# the whole set rather than over the answerable part of it.
#
# Not the same setting as QUESTIONS_DIFFICULTY_MIX, and the two are not meant
# to match. That one is what the planner aims the answerable questions at,
# and it has to run harder than this to leave room for the unanswerable ones
# that land in easy whatever it asks for.
#
# Which kinds a release holds is not here: it reuses QUESTIONS_TYPE_MIX, so
# the types a deployment turned off do not get a quota they cannot fill.
QUESTIONS_RELEASE_DIFFICULTY=easy:1,medium:1,hard:1
